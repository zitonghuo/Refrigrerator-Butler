page{background:#f3f7f9;color:#173d39;font-family:system-ui;font-size:28rpx}button{background:#216855;color:#fff;font-size:27rpx;border-radius:18rpx;margin:16rpx 0}button::after{border:0}input{background:#f3f7f9;border:1rpx solid #dce6e6;border-radius:14rpx;padding:20rpx;margin:14rpx 0;color:#173d39}.wrap{padding:30rpx 30rpx 160rpx}.brand{font-size:25rpx;letter-spacing:4rpx;margin:15rpx 0 35rpx;color:#718482}.title{font-size:47rpx;font-weight:700;line-height:1.4}.sub{color:#718482;font-size:25rpx;line-height:1.7;margin:14rpx 0 28rpx}.panel{background:white;border:1rpx solid #dce6e6;border-radius:26rpx;padding:28rpx;margin:20rpx 0}.hero{background:#e3eff6;border-radius:26rpx;padding:30rpx;margin:28rpx 0}.hero .title{font-size:37rpx}.shelf{font-size:66rpx;border-bottom:10rpx solid #c1d5df;text-align:center;margin:20rpx 0 10rpx}.row{display:flex;justify-content:space-between;align-items:center;gap:16rpx}.row button{flex:1}.name{font-size:33rpx;font-weight:600}.badge{font-size:22rpx;background:#edf3f0;color:#557565;padding:8rpx 14rpx;border-radius:10rpx}.urgent,.soon,.expired{background:#fff0df;color:#a56528}.detail{font-size:24rpx;color:#718482;line-height:1.8;margin:12rpx 0}.secondary{background:#eaf1ef;color:#173d39}.small{font-size:24rpx;padding:0 20rpx;line-height:2.8}.tabs{display:flex;flex-wrap:wrap;gap:10rpx;margin:24rpx 0}.tabs button{font-size:24rpx;padding:0 20rpx;margin:0;background:#eaf1ef;color:#173d39}.tabs .active{background:#173d39;color:white}.bottom{position:fixed;bottom:0;left:0;right:0;background:white;display:flex;padding:15rpx 10rpx calc(15rpx + env(safe-area-inset-bottom));border-top:1rpx solid #dce6e6;z-index:2}.bottom view{flex:1;text-align:center;font-size:22rpx;color:#718482;padding:12rpx 0}.bottom .active{color:#216855;font-weight:bold}.code{word-break:break-all;color:#216855;line-height:1.8}.label{font-size:24rpx;color:#718482;margin-top:18rpx}.picker{background:#f3f7f9;padding:20rpx;margin:14rpx 0;border-radius:14rpx}.error{color:#a63f34;font-size:25rpx;margin:16rpx 0}.done{text-decoration:line-through;color:#718482}.sep{border-top:1rpx solid #dce6e6;padding-top:20rpx;margin-top:20rpx}
