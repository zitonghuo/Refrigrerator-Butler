<view class="wrap">
 <view class="brand">▥ 冰箱管家 · FRIDGE KEEPER</view>
 <block wx:if="{{!logged}}">
  <view class="title">记得冰箱里，<view>还有一顿好饭。</view></view><view class="sub">把食材放进账本，和家人共享每一份新鲜。</view>
  <view class="hero"><view class="shelf">🥦　🥛　🍅　🥚</view></view>
  <view class="tabs"><button class="{{authMode==='create'?'active':''}}" data-mode="create" bindtap="authMode">创建家庭</button><button class="{{authMode==='join'?'active':''}}" data-mode="join" bindtap="authMode">加入家庭</button><button class="{{authMode==='login'?'active':''}}" data-mode="login" bindtap="authMode">恢复登录</button></view>
  <view class="panel"><input wx:if="{{authMode!=='login'}}" placeholder="你的称呼" data-field="name" bindinput="field" value="{{form.name}}" maxlength="24"/><input wx:if="{{authMode==='create'}}" placeholder="家庭名称" value="{{form.homeName}}" data-field="homeName" bindinput="field"/><input wx:if="{{authMode==='join'}}" placeholder="家庭邀请码" data-field="invite" bindinput="field"/><input wx:if="{{authMode==='login'}}" placeholder="个人恢复码" data-field="code" bindinput="field" maxlength="120"/><button bindtap="authenticate" loading="{{busy}}" disabled="{{busy}}">进入我的厨房</button><view class="detail">首次创建后请保存个人恢复码。</view></view>
 </block>
 <block wx:else>
  <view class="sub">⌂ {{state.home.name}} · {{state.user}}</view>
  <block wx:if="{{tab==='inventory'||tab==='urgent'}}">
   <view class="title">{{tab==='urgent'?'先吃这一份新鲜。':'每一份新鲜，都记得。'}}</view>
   <view class="hero"><view class="name">{{state.items.length}} 批食材 · {{urgentCount}} 批即将到期</view><view class="detail">合理安排下一顿饭，少一点遗忘。</view><view class="shelf">🥦　🥛　🍅　🥚</view></view>
   <view class="tabs"><button wx:for="{{filters}}" wx:key="*this" class="{{filter===item?'active':''}}" data-filter="{{item}}" bindtap="filter">{{item}}</button><button data-tab="{{tab==='urgent'?'inventory':'urgent'}}" bindtap="tab">{{tab==='urgent'?'全部库存':'只看临期'}}</button></view>
   <view class="panel" wx:for="{{visible}}" wx:key="id"><view class="row"><view class="name">{{item.name}}</view><view class="badge {{item.band}}">{{item.label}}</view></view><view class="detail">{{item.location}} · {{item.expiry||'待补日期'}} · {{item.sourceLabel}}</view><view class="row"><view>{{item.quantity}} {{item.unit}}</view><button class="secondary small" data-id="{{item.id}}" bindtap="manage">管理库存</button></view></view>
   <view wx:if="{{!visible.length}}" class="panel"><view class="name">这里还没有食材</view><view class="sub">添加真实食材，或先用样例熟悉操作。</view><button wx:if="{{!state.items.length}}" class="secondary" bindtap="demo">加载演示库存</button><button data-tab="add" bindtap="tab">添加食材</button></view>
   <view class="detail">日期用于库存管理，不代表安全保证，请结合实际状态和包装说明判断。</view>
  </block>
  <block wx:if="{{tab==='add'}}"><view class="title">把新鲜放进冰箱</view><view class="sub">先确认，再入库；每一项保留独立批次。</view><view class="row"><button class="secondary small" data-kind="photo" bindtap="choose" disabled="{{busy}}">拍食材</button><button class="secondary small" data-kind="receipt" bindtap="choose" disabled="{{busy}}">拍小票</button><button class="secondary small" data-kind="video" bindtap="choose" disabled="{{busy}}">拍视频</button></view><view class="detail">识别需要配置服务；未配置时可手动录入。视频请控制在 30 秒、20 MB 内。</view><view class="detail">{{taskStatus}}</view>
   <view class="panel" wx:for="{{candidates}}" wx:key="index"><view class="label">食材名称</view><input value="{{item.name}}" data-index="{{index}}" data-field="name" bindinput="candidate" placeholder="例如：番茄"/><view class="row"><input type="digit" value="{{item.quantity}}" data-index="{{index}}" data-field="quantity" bindinput="candidate" placeholder="数量"/><input value="{{item.unit}}" data-index="{{index}}" data-field="unit" bindinput="candidate" placeholder="单位"/></view><picker range="{{locations}}" data-index="{{index}}" bindchange="location"><view class="picker">储存位置：{{item.location}}</view></picker><picker mode="date" value="{{item.expiry}}" data-index="{{index}}" data-field="expiry" bindchange="candidate"><view class="picker">到期日期：{{item.expiry||'点击填写'}}</view></picker><picker range="{{sourceNames}}" data-index="{{index}}" bindchange="source"><view class="picker">日期来源：{{sourceLabels[item.source]}}</view></picker><button class="secondary small" data-index="{{index}}" bindtap="removeRow">移除此项</button></view>
   <button class="secondary" bindtap="addRow">＋ 再加一项</button><button bindtap="save" loading="{{busy}}" disabled="{{busy}}">确认入库</button>
  </block>
  <block wx:if="{{tab==='shopping'}}"><view class="title">买刚刚好的份量。</view><view class="sub">家人共享一张采购清单。</view><view class="panel"><input placeholder="下次要买什么？" value="{{shoppingName}}" bindinput="shoppingInput"/><button bindtap="addShopping">加入清单</button><view class="row sep" wx:for="{{state.shopping}}" wx:key="id"><view class="{{item.done?'done':''}}">{{item.name}}</view><button class="secondary small" data-id="{{item.id}}" bindtap="toggleShopping">{{item.done?'重新采购':'标记已买'}}</button></view></view></block>
  <block wx:if="{{tab==='family'}}"><view class="title">一家人的小厨房。</view><view class="panel"><view class="name">{{state.home.name}}</view><view class="detail">家庭成员</view><view wx:for="{{state.members}}" wx:key="index">{{item.name}}</view><view class="label">家庭邀请码</view><view class="code" user-select>{{state.home.invite}}</view><button bindtap="copyInvite">复制邀请码</button><button class="secondary" bindtap="rotateInvite">更换邀请码</button><view class="detail">邀请码持有者可以加入，请只分享给家人。个人恢复码仅用于本人登录。</view></view><button class="secondary" data-tab="history" bindtap="tab">查看食材操作记录</button><button class="secondary" bindtap="logout">退出登录</button></block>
  <block wx:if="{{tab==='history'}}"><view class="title">每一次变化，都有记录。</view><view class="panel" wx:for="{{state.events}}" wx:key="id"><view class="name">{{item.name}}</view><view class="detail">{{item.kind}} {{item.quantity}} {{item.unit}} · {{item.actor}}</view><view class="detail">{{item.created}}</view></view></block>
 </block><view class="error">{{error}}</view>
</view><view wx:if="{{logged}}" class="bottom"><view class="{{tab==='inventory'||tab==='urgent'?'active':''}}" data-tab="inventory" bindtap="tab">我的冰箱</view><view class="{{tab==='add'?'active':''}}" data-tab="add" bindtap="tab">＋ 入库</view><view class="{{tab==='shopping'?'active':''}}" data-tab="shopping" bindtap="tab">采购</view><view class="{{tab==='family'?'active':''}}" data-tab="family" bindtap="tab">家庭</view></view>
