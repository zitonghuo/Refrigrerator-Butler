page{background:#f2f6fa;color:#20384a;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;line-height:1.6}
button{background:#197c80;color:#fff;font-size:28rpx;font-weight:600;border-radius:18rpx;margin:20rpx 0;padding:8rpx 24rpx;line-height:2.4}button::after{border:0}button[disabled]{opacity:.5}input{box-sizing:border-box;width:100%;height:92rpx;background:#f2f6fa;border:2rpx solid #dbe5ed;border-radius:16rpx;padding:18rpx 22rpx;margin:12rpx 0 22rpx;color:#20384a;font-size:28rpx}.wrap{padding:24rpx 32rpx 190rpx}.topbar,.heading,.row{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.topbar{margin-bottom:34rpx}.brand{font-size:30rpx;font-weight:700}.brand-icon{color:#197c80;font-size:40rpx;vertical-align:middle}.text-button{background:transparent;color:#197c80;font-size:24rpx;font-weight:500;padding:8rpx 0;margin:0;line-height:2;flex-shrink:0}.topbar .text-button{font-size:22rpx}.eyebrow{font-size:23rpx;color:#647b8b;margin-bottom:12rpx;letter-spacing:2rpx}.title{font-size:48rpx;font-weight:750;line-height:1.3;letter-spacing:-1rpx}.welcome{font-size:62rpx;line-height:1.25;margin-top:22rpx}.sub{font-size:26rpx;color:#647b8b;line-height:1.8;margin:20rpx 0 30rpx}.panel{background:#fff;border:2rpx solid #e0e8ef;border-radius:24rpx;padding:28rpx;margin:22rpx 0}.section-title{font-size:30rpx;font-weight:650}.name{font-size:31rpx;font-weight:650}.muted{font-size:23rpx;color:#647b8b;font-weight:400}.detail{font-size:24rpx;color:#647b8b;line-height:1.8;margin:14rpx 0}.label{font-size:25rpx;font-weight:550;color:#526b7d;margin-top:8rpx}.secondary{background:#eaf3f3;color:#17666b}.small{font-size:25rpx;padding:4rpx 28rpx;line-height:2.4;margin:0;flex-shrink:0}.tabs{display:flex;gap:8rpx;padding:6rpx;background:#e4ecf2;border-radius:18rpx;margin-top:30rpx}.tabs button{flex:1;background:transparent;color:#526b7d;font-size:25rpx;margin:0;padding:8rpx 6rpx}.tabs .active{background:#fff;color:#17666b;box-shadow:0 3rpx 8rpx #20384a0a}.fridge-preview{background:#e2edf7;border:2rpx solid #cbdcea;border-radius:30rpx 30rpx 20rpx 20rpx;padding:24rpx 28rpx;margin:28rpx 0;box-shadow:inset 8rpx 0 0 #f7fbff}.fridge-heading{display:flex;justify-content:space-between;font-size:25rpx;font-weight:650;color:#3f607a;padding:0 0 16rpx}.fridge-heading text{font-size:22rpx;font-weight:400}.shelf{display:flex;justify-content:space-between;align-items:center;min-height:76rpx;border-bottom:6rpx solid #b7cfdf;color:#3f607a;font-size:25rpx}.shelf:last-child{border-bottom:0}.shelf text:first-child{font-weight:650}.zone{display:flex;justify-content:space-between;align-items:center;width:100%;background:transparent;color:#3f607a;margin:0;border-radius:0;border-bottom:4rpx solid #c4d8e7;font-weight:500;text-align:left;padding:8rpx 18rpx;line-height:2}.zone:last-child{border-bottom:0}.zone.selected{background:#fff;border-radius:14rpx;color:#17666b;border-color:transparent}.count{font-family:Consolas,monospace;font-size:34rpx;font-weight:700}.arrow{margin-left:18rpx}.summary{display:flex;justify-content:space-around;margin:30rpx 0}.summary>view{display:flex;flex-direction:column;text-align:center;font-size:23rpx;color:#647b8b}.stat{font-size:42rpx;color:#197c80;font-family:Consolas,monospace;font-weight:700}.warning{color:#a86a21}.danger{color:#b84d55}.search{background:#fff;margin:26rpx 0}.chip{font-size:23rpx;padding:8rpx 16rpx;line-height:1.7;background:#e4ecf2;color:#526b7d;margin:0;border-radius:12rpx;flex-shrink:0}.chip.active{background:#197c80;color:white}.food-name{overflow-wrap:break-word;word-break:break-all;min-width:0}.badge{font-size:22rpx;padding:5rpx 14rpx;background:#edf4f5;color:#526b7d;border-radius:10rpx;white-space:nowrap}.badge.expired{color:#a33542;background:#fbe8ec}.badge.urgent,.badge.soon{color:#94601f;background:#fff2d9}.badge.fresh{color:#17666b;background:#e6f4ef}.quantity{font-size:34rpx;font-weight:650}.inventory-item{margin:16rpx 0}.field{flex:1;min-width:0}.picker{display:flex;justify-content:space-between;gap:12rpx;padding:22rpx 0;border-bottom:2rpx solid #e9eff4;font-size:26rpx}.picker text{color:#197c80}.empty{text-align:center;padding-top:38rpx;padding-bottom:38rpx}.empty-icon{font-size:68rpx;color:#9cb7cc;margin-bottom:16rpx}.error{background:#fbe8ec;color:#9d3541;border-radius:16rpx;padding:24rpx;font-size:25rpx;margin-bottom:24rpx;word-break:break-word}.notice{background:#fff2d9;border-radius:18rpx;padding:24rpx;margin-bottom:24rpx}.code{font-family:Consolas,monospace;word-break:break-all;background:#f2f6fa;padding:20rpx;border-radius:12rpx;color:#17666b;font-size:26rpx}.shopping-row{display:flex;justify-content:space-between;align-items:center;gap:20rpx;padding:24rpx 0;border-bottom:2rpx solid #e9eff4}.shopping-row>view{min-width:0;word-break:break-all}.shopping-row:last-child{border-bottom:0}.done{text-decoration:line-through;color:#8c9daa}.member{display:flex;gap:20rpx;align-items:center;padding-top:24rpx}.avatar{background:#e2edf7;color:#3f607a;border-radius:50%;width:64rpx;height:64rpx;text-align:center;line-height:64rpx;font-size:36rpx}.footnote{text-align:center;font-size:22rpx;margin-top:32rpx}.bottom{position:fixed;bottom:0;left:0;right:0;display:flex;background:#fff;border-top:2rpx solid #e0e8ef;padding:12rpx 12rpx calc(12rpx + env(safe-area-inset-bottom));z-index:5}.bottom button{flex:1;background:transparent;color:#647b8b;font-size:22rpx;font-weight:400;padding:0;margin:0;line-height:1.6;border-radius:14rpx}.bottom .active{color:#17666b;background:#edf6f4;font-weight:650}.nav-icon{font-size:37rpx;height:50rpx;line-height:50rpx}

.member-row{padding:24rpx 0;border-bottom:2rpx solid #e0e8ef}.agreement{display:flex;align-items:center;font-size:25rpx;gap:12rpx}.legal .section-title{margin-top:30rpx}.legal .detail{font-size:27rpx;color:#526b7d}.wrap{padding-bottom:60rpx}.title{word-break:break-word}
