<view class="wrap"><button class="secondary" bindtap="media" disabled="{{busy || loading}}">拍照 / 录像预览</button><view class="title">把新鲜记下来</view><view class="sub">每批食材单独记录，日期不确定时可以留空。</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{loading}}" class="detail">正在同步…</view><view class="panel" wx:for="{{rows}}" wx:key="index"><view class="heading"><view class="section-title">食材 {{index+1}}</view><button class="text-button" data-index="{{index}}" bindtap="remove" disabled="{{busy}}">移除</button></view><view class="label">名称</view><input value="{{item.name}}" data-index="{{index}}" data-field="name" bindinput="input" placeholder="例如：番茄" maxlength="80" disabled="{{busy}}"/><view class="row"><view class="field"><view class="label">数量</view><input type="digit" value="{{item.quantity}}" data-index="{{index}}" data-field="quantity" bindinput="input" disabled="{{busy}}"/></view><view class="field"><view class="label">单位</view><input value="{{item.unit}}" data-index="{{index}}" data-field="unit" bindinput="input" maxlength="12" disabled="{{busy}}"/></view></view><picker range="{{locations}}" bindchange="location" data-index="{{index}}" disabled="{{busy}}"><view class="picker">存放位置<text>{{item.location}} ›</text></view></picker><picker mode="date" value="{{item.expiry}}" bindchange="input" data-index="{{index}}" data-field="expiry" disabled="{{busy}}"><view class="picker">到期日期<text>{{item.expiry || '暂不填写'}} ›</text></view></picker><button wx:if="{{item.expiry}}" class="text-button" data-index="{{index}}" bindtap="clearDate" disabled="{{busy}}">清除日期</button><picker range="{{sources}}" bindchange="source" data-index="{{index}}" disabled="{{busy}}"><view class="picker">日期来源<text>{{sourceLabels[item.source]}} ›</text></view></picker></view><button class="secondary" bindtap="addRow" disabled="{{busy || rows.length>=20}}">＋ 再加一项</button><button bindtap="save" loading="{{busy}}" disabled="{{busy || loading}}">确认入库 · {{rows.length}} 项</button></view>