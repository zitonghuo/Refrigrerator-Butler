<view class="wrap"><view class="eyebrow">用已有食材，少买一点</view><view class="title">冰箱里能做什么</view><picker range="{{options}}" value="{{servings-1}}" bindchange="servings" disabled="{{loading || busy}}"><view class="picker">用餐人数<text>{{servings}} 人 ›</text></view></picker><view wx:if="{{error}}" class="error">{{error}}<button bindtap="refresh">重试</button></view><view wx:if="{{loading}}" class="detail">正在匹配食材…</view><view class="panel" wx:for="{{recipes}}" wx:key="id"><view class="heading"><view class="name">{{item.name}}</view><text class="badge">约 {{item.minutes}} 分钟</text></view><view class="detail">已有：{{item.matchedText}}</view><view class="detail">还缺：{{item.missingText}}</view><view class="steps" wx:for="{{item.steps}}" wx:for-item="step" wx:for-index="stepIndex" wx:key="*this">{{stepIndex+1}}. {{step}}</view><button wx:if="{{item.missing.length}}" class="secondary" data-id="{{item.id}}" bindtap="buy" disabled="{{busy || loading}}">把缺少的食材加入采购</button></view><view class="detail">{{note}}</view></view>
