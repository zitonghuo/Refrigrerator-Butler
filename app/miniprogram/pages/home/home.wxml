<view class="wrap"><view class="eyebrow">{{home.name || '一家人的食材账本'}}</view><view class="heading"><view class="title">我的冰箱</view><button class="small" bindtap="add">＋ 添加</button></view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{loading}}" class="detail">正在同步…</view><button wx:if="{{error}}" class="secondary" bindtap="refresh">重新同步</button><view class="fridge-preview"><view class="fridge-heading">食材分区<text>{{items.length}} 批在库</text></view><button wx:for="{{zones}}" wx:key="name" class="zone {{filter===item.name?'selected':''}}" data-name="{{item.name}}" bindtap="filter"><text>{{item.name}}</text><view><text class="count">{{item.count}}</text><text class="muted"> 批 ›</text></view></button></view><view class="summary"><view><text class="stat warning">{{urgent}}</text><text>3 天内到期</text></view><view><text class="stat danger">{{expired}}</text><text>已过期</text></view><view><text class="stat">{{pending}}</text><text>待采购</text></view></view><view class="panel"><view class="section-title">今天的冰箱安排</view><button class="secondary" bindtap="today">今日待办 · 临期与采购</button><view class="row"><button class="secondary field" bindtap="recipes">做什么菜</button><button class="secondary field" bindtap="reports">周报 / 月报</button></view><button class="secondary" bindtap="reminders">微信到期提醒</button></view><input value="{{query}}" placeholder="搜索食材名称" bindinput="search"/><view class="heading"><view class="section-title">{{filter}}食材 · {{visible.length}}</view><button class="chip {{urgentOnly?'active':''}}" bindtap="urgent">{{urgentOnly?'✓ ':''}}临期与过期</button></view><view class="panel" wx:for="{{visible}}" wx:key="id" data-id="{{item.id}}" bindtap="detail"><view class="heading"><view class="name food-name">{{item.name}}</view><text class="badge {{item.band}}">{{item.label}}</text></view><view class="detail">{{item.location}} · {{item.expiry || '日期待补'}}</view><view class="heading"><view class="quantity">{{item.quantity}} <text class="muted">{{item.unit}}</text></view><text class="muted">查看详情 ›</text></view></view><view wx:if="{{!loading && !visible.length}}" class="panel empty"><view class="name">{{items.length?'没有匹配的食材':'还没有食材记录'}}</view><button wx:if="{{items.length}}" class="secondary" bindtap="clear">清除筛选</button><button wx:else bindtap="add">添加第一份食材</button></view><view class="footnote detail">日期用于库存管理，请结合包装与实际状态判断食材是否可食用。</view></view>
