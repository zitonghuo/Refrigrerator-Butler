<view class="wrap"><view class="title">买得刚刚好</view><view class="sub">{{pending}} 项待采购，家人共用一张清单。</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{loading}}" class="detail">正在同步…</view><button wx:if="{{error}}" class="secondary" bindtap="refresh">刷新清单</button><view class="panel"><input placeholder="下次要买什么？" value="{{name}}" bindinput="input" maxlength="80" disabled="{{busy}}"/><button bindtap="add" disabled="{{busy || loading}}" loading="{{busy}}">加入清单</button></view><view class="panel" wx:for="{{items}}" wx:key="id"><view class="heading"><view class="name {{item.done?'done':''}}">{{item.name}}</view><button class="small secondary" bindtap="toggle" data-id="{{item.id}}" disabled="{{busy || loading}}">{{item.done?'撤销已买':'标记已买'}}</button></view><button class="text-button" bindtap="remove" data-id="{{item.id}}" disabled="{{busy || loading}}">删除</button></view><view wx:if="{{!loading && !items.length}}" class="panel empty">暂时没有要买的食材</view></view>