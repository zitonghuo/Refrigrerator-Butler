<view class="wrap"><view class="eyebrow">先看日期，再安排一餐</view><view class="title">今天先做什么</view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="refresh">重试</button></view><view wx:if="{{loading}}" class="detail">正在整理待办…</view><view class="row"><button class="secondary field" bindtap="recipes">看看能做什么菜</button><button class="secondary field" bindtap="reminders">微信到期提醒</button></view><block wx:for="{{groups}}" wx:key="name"><view wx:if="{{item.items.length}}" class="panel"><view class="section-title">{{item.name}}</view><view wx:for="{{item.items}}" wx:for-item="food" wx:key="id" class="entry" data-id="{{food.id}}" bindtap="detail"><view class="name">{{food.name}}</view><view class="detail">{{food.expiry}} · {{food.quantity}} {{food.unit}} · {{food.location}} ›</view></view></view></block><view wx:if="{{shopping.length}}" class="panel"><view class="section-title">还要买 · {{shopping.length}} 项</view><view wx:for="{{shopping}}" wx:key="id" class="entry">{{item.name}}</view><button class="secondary" bindtap="shopping">打开采购清单</button></view><view wx:if="{{empty && !loading && !error}}" class="panel empty">今天没有临期待办和待采购项。</view><view class="detail">日期提醒不代表食材安全；已过期食材不参与菜谱匹配。</view></view>
