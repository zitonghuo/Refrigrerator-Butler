<view class="wrap">
  <view class="title">把食材拍下来</view>
  <view class="sub">拍照看看包装，录像看看冰箱。照片最多 4 MB；视频最多 30 秒、12 MB。</view>
  <view wx:if="{{!cloudEnabled}}" class="notice detail">本地预览模式：只查看不会上传，也不会与家人共享。需要留存时，请点击“保存到手机相册”。退出页面后临时预览不保留。</view>
  <view wx:else class="notice detail">家庭成员可查看附件。当前附件保留 30 天；重要资料请自行留存。识别结果需人工核对，不会自动判断食材是否安全。</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <button wx:if="{{error && cloudEnabled}}" class="secondary" bindtap="refresh" disabled="{{busy}}">刷新附件</button>
  <view class="row">
    <button class="field" data-kind="image" bindtap="capture" disabled="{{busy || loading}}">拍照 / 选照片</button>
    <button class="field secondary" data-kind="video" bindtap="capture" disabled="{{busy || loading}}">录像 / 选视频</button>
  </view>
  <view wx:if="{{local}}" class="panel">
    <image wx:if="{{local.kind==='image'}}" src="{{local.path}}" mode="widthFix" class="media-image" bindtap="previewLocal" binderror="localError"/>
    <video wx:else src="{{local.path}}" controls class="media-video" binderror="localError"/>
    <view wx:if="{{local.kind==='image'}}" class="detail">点击照片可放大查看。</view>
    <button wx:if="{{cloudEnabled}}" bindtap="upload" loading="{{busy}}" disabled="{{busy}}">上传并保存</button>
    <button wx:if="{{!cloudEnabled && visionEnabled}}" bindtap="recognizeLocal" loading="{{busy}}" disabled="{{busy}}">用本机模型识别</button>
    <button wx:if="{{local.kind==='image'}}" bindtap="recognizeGlm" loading="{{busy}}" disabled="{{busy}}">智谱识别食材</button>
    <button wx:if="{{local.kind==='image'}}" data-kind="receipt" bindtap="recognizeGlm" loading="{{busy}}" disabled="{{busy}}">识别小票商品名</button>
    <button class="secondary" bindtap="saveLocal" disabled="{{busy}}">保存到手机相册</button><button class="secondary" bindtap="clearLocal" disabled="{{busy}}">清除本次预览</button>
  </view>
  <view class="detail">{{status}}</view>
  <view wx:if="{{preview}}" class="panel">
    <image wx:if="{{preview.kind==='image'}}" src="{{preview.url}}" mode="widthFix" class="media-image" binderror="previewError"/>
    <video wx:else src="{{preview.url}}" controls class="media-video" binderror="previewError"/>
  </view>
  <view wx:if="{{suggestion}}" class="panel">
    <view class="section-title">核对识别结果</view>
    <view class="label">食材名称</view><input value="{{suggestion.name}}" data-field="name" bindinput="field" maxlength="80"/>
    <view class="detail">生产日期：{{suggestion.production || '未明确识别'}}；保质期：{{suggestion.shelfLife || '未明确识别'}}。</view>
    <view class="label">到期日期（YYYY-MM-DD，可留空）</view><input value="{{suggestion.expiry}}" data-field="expiry" bindinput="field" maxlength="10"/>
    <view class="detail">不会用生产日期冒充到期日期，也不会自动推算未明确标注的有效期。</view>
    <text selectable class="ocr-text">{{suggestion.text}}</text>
    <checkbox-group bindchange="agreement"><label><checkbox value="checked" checked="{{confirmed}}"/>我已对照包装核对</label></checkbox-group>
    <button bindtap="use" disabled="{{busy || !confirmed}}">带入入库表单</button>
  </view>
  <view wx:if="{{foods}}" class="panel">
    <view class="section-title">画面里的食材（{{foods.length}}）</view>
    <view wx:for="{{foods}}" wx:key="index" class="food-row">
      <view wx:if="{{item.receiptLine}}" class="detail">票面文字：{{item.receiptLine}}</view><view wx:if="{{item.receiptLine && item.name.length === 1}}" class="detail">可能漏字，请对照照片补全。</view><view class="heading"><view class="label">食材 {{index+1}}</view><button class="text-button danger" data-index="{{index}}" bindtap="removeFood" disabled="{{busy}}">移除</button></view>
      <view class="label">名称</view><input value="{{item.name}}" maxlength="80" placeholder="修改食材名称" data-index="{{index}}" data-field="name" bindinput="changeFood" disabled="{{busy}}"/>
      <view class="row"><view class="field"><view class="label">数量</view><input type="digit" value="{{item.quantity || ''}}" placeholder="填写数量" data-index="{{index}}" data-field="quantity" bindinput="changeFood" disabled="{{busy}}"/></view>
      <view class="field"><view class="label">单位</view><picker range="{{units}}" data-index="{{index}}" bindchange="chooseUnit" disabled="{{busy}}"><view class="picker">{{item.unit || '选单位'}} ▾</view></picker><input placeholder="或输入自定义单位" value="{{item.unit}}" maxlength="12" data-index="{{index}}" data-field="unit" bindinput="changeFood" disabled="{{busy}}"/></view></view>
      <picker range="{{locations}}" value="{{item.location === '冷冻' ? 1 : item.location === '常温' ? 2 : 0}}" data-index="{{index}}" data-field="location" bindchange="changeFood" disabled="{{busy}}"><view class="picker">存放位置<text>{{item.location}} ›</text></view></picker>
      <picker mode="date" value="{{item.expiry}}" data-index="{{index}}" data-field="expiry" bindchange="changeFood" disabled="{{busy}}"><view class="picker">到期日期<text>{{item.expiry || '选填'}} ›</text></view></picker>
      <button wx:if="{{item.expiry}}" class="text-button" data-index="{{index}}" bindtap="clearFoodDate" disabled="{{busy}}">清除日期</button>
    </view>
    <checkbox-group wx:if="{{foods.length}}" bindchange="agreement"><label><checkbox value="checked" checked="{{confirmed}}" disabled="{{busy}}"/>我已核对以上食材</label></checkbox-group>
    <button wx:if="{{foods.length}}" bindtap="useFoods" loading="{{busy}}" disabled="{{busy || !confirmed}}">确认入库 · {{foods.length}} 项</button>
  </view>
  <button wx:if="{{!cloudEnabled}}" class="secondary" bindtap="manual" disabled="{{busy}}">手动添加食材</button>
  <view wx:if="{{cloudEnabled}}" class="section-title">{{itemId?'这份食材的附件':'家庭照片与视频'}}</view>
  <view wx:for="{{items}}" wx:key="id" class="panel">
    <view class="name">{{item.kind==='image'?'照片':'视频'}} · {{index+1}}</view>
    <view class="row">
      <button class="secondary field" data-id="{{item.id}}" bindtap="view" disabled="{{busy}}">查看</button>
      <button wx:if="{{item.kind==='image'}}" class="secondary field" data-id="{{item.id}}" bindtap="recognize" disabled="{{busy}}">识别包装</button>
      <button wx:if="{{item.kind==='image'}}" class="secondary field" data-id="{{item.id}}" bindtap="recognizeFood" disabled="{{busy}}">识别食材</button>
      <button class="text-button danger" data-id="{{item.id}}" bindtap="remove" disabled="{{busy}}">删除</button>
    </view>
  </view>
  <view wx:if="{{cloudEnabled && !items.length && !loading}}" class="detail">暂无已保存附件。可以先拍照或录一段视频。</view>
</view>
