<view class="wrap"><view class="title">个人中心</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{loading}}" class="detail">正在同步…</view><button wx:if="{{error}}" class="secondary" bindtap="refresh">重新加载</button><view wx:if="{{pending}}" class="notice"><view class="name">有一笔操作尚未确认</view><view class="detail">将使用原操作编号重试，避免重复提交。超过 24 小时的请求会被拒绝；届时请核对库存后重新操作。</view><button bindtap="recover" disabled="{{busy || loading}}">恢复提交</button></view><view class="panel"><view class="section-title">今天的冰箱安排</view><button class="secondary" bindtap="today">今日待办 · 临期与采购</button><view class="row"><button class="secondary field" bindtap="recipes">做什么菜</button><button class="secondary field" bindtap="reports">周报 / 月报</button></view><button class="secondary" bindtap="reminders">微信到期提醒</button></view><view class="panel"><view class="label">家庭中显示的称呼</view><input value="{{name}}" bindinput="input" maxlength="24" disabled="{{busy}}"/><button bindtap="save" disabled="{{busy || loading}}">保存称呼</button><view class="detail">不会读取你的微信头像、昵称或手机号。</view></view><view class="panel"><view class="section-title">{{home?home.name:'尚未加入家庭'}}</view><button wx:if="{{!home}}" class="secondary" bindtap="home">创建或加入家庭</button><button class="secondary" bindtap="privacy">隐私说明</button><button class="secondary" bindtap="contact">复制联系邮箱</button><view class="detail">{{email}}</view></view><button class="secondary" bindtap="logout" disabled="{{busy || loading}}">退出登录</button><button class="text-button danger" bindtap="remove" disabled="{{busy || loading}}">注销账号</button><view class="footnote detail">小满冰箱 · 冷鲜栈</view></view>
