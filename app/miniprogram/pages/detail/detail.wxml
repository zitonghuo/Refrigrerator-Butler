<view class="wrap"><button class="secondary" bindtap="media" disabled="{{busy || loading}}">照片与视频</button><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{loading}}" class="detail">正在同步…</view><button wx:if="{{error}}" class="secondary" bindtap="refresh">刷新详情</button><block wx:if="{{item}}"><view class="heading"><view class="title">{{item.name}}</view><text class="badge {{item.band}}">{{item.label}}</text></view><view class="panel"><view class="quantity">{{item.quantity}} <text class="muted">{{item.unit}}</text></view><view class="detail">存放位置：{{item.location}}</view><view class="detail">到期日期：{{item.expiry || '待补日期'}}</view><button class="secondary" bindtap="edit" disabled="{{busy}}">{{editing?'取消修改':'修改资料'}}</button><view wx:if="{{editing}}"><view class="label">名称</view><input value="{{form.name}}" data-field="name" bindinput="input" maxlength="80" disabled="{{busy}}"/><view class="label">单位</view><input value="{{form.unit}}" data-field="unit" bindinput="input" maxlength="12" disabled="{{busy}}"/><picker range="{{locations}}" bindchange="location" disabled="{{busy}}"><view class="picker">存放位置<text>{{form.location}}</text></view></picker><picker mode="date" value="{{form.expiry}}" data-field="expiry" bindchange="input" disabled="{{busy}}"><view class="picker">到期日期<text>{{form.expiry || '不填写'}}</text></view></picker><button class="text-button" bindtap="clearDate" disabled="{{busy}}">清除日期</button><button bindtap="save" loading="{{busy}}" disabled="{{busy}}">保存修改</button></view></view><view class="row"><button class="field" data-kind="消耗" bindtap="change" disabled="{{busy || loading}}">记录消耗</button><button class="field secondary" data-kind="丢弃" bindtap="change" disabled="{{busy || loading}}">记录丢弃</button></view><button class="secondary" data-kind="盘点" bindtap="change" disabled="{{busy || loading}}">盘点剩余量</button><view class="section-title">这份食材的记录</view><view class="panel" wx:for="{{events}}" wx:key="id"><view>{{item.kind}} · {{item.quantity}} {{item.unit}}</view><view class="detail">{{item.actor}} · {{item.time}}</view></view></block></view>