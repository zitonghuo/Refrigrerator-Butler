<view class="wrap"><view class="title">每份食材的去向</view><view class="sub">保留最近 200 条家庭操作记录。</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{loading}}" class="detail">正在同步…</view><view class="panel" wx:for="{{events}}" wx:key="id"><view class="heading"><view class="name">{{item.name}}</view><text class="badge">{{item.kind}}</text></view><view class="detail">{{item.quantity}} {{item.unit}} · {{item.actor}}</view><view class="detail">{{item.time}}</view></view><view wx:if="{{!loading && !events.length}}" class="panel empty">还没有操作记录</view></view>