<view class="wrap"><button class="secondary" bindtap="media" disabled="{{busy || loading}}">照片与视频</button><view class="title">一家人的冰箱</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{loading}}" class="detail">正在同步…</view><button wx:if="{{error}}" class="secondary" bindtap="refresh">重新同步</button><block wx:if="{{home}}"><view class="panel"><view class="name">{{home.name}}</view><view class="detail">{{home.members.length}} 位成员 · {{home.isOwner?'你是家庭创建者':'你是家庭成员'}}</view><view class="member-row" wx:for="{{home.members}}" wx:key="id"><view>{{item.name}} <text class="muted">{{item.id===home.ownerId?'创建者':''}}{{item.id===user.id?' · 我':''}}</text></view><view wx:if="{{home.isOwner && item.id!==user.id}}" class="row"><button class="text-button" data-id="{{item.id}}" bindtap="transfer" disabled="{{busy || loading}}">转让管理权</button><button class="text-button danger" data-id="{{item.id}}" bindtap="remove" disabled="{{busy || loading}}">移除</button></view></view></view><view wx:if="{{home.isOwner}}" class="panel"><view class="section-title">邀请家人</view><view class="detail">邀请码持有者可以加入家庭，请只分享给家人。</view><view class="code" user-select="true">{{home.invite}}</view><view class="detail">到期时间：{{expiry}}</view><button bindtap="copy">复制邀请码</button><button class="secondary" bindtap="rotate" disabled="{{busy || loading}}">更换邀请码</button></view><view wx:else class="notice">需要邀请其他家人时，请联系家庭创建者获取邀请码。</view><button class="secondary" bindtap="history">查看操作记录</button><button class="text-button danger" bindtap="leave" disabled="{{busy || loading}}">退出家庭</button></block></view>