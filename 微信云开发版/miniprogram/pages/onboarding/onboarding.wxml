<view class="wrap"><view class="eyebrow">小满冰箱</view><view class="title">先找到你的厨房</view><view class="sub">一家人共用一份库存；不同家庭的数据独立保存。</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{loading}}" class="detail">正在同步…</view><view class="tabs"><button data-mode="create" bindtap="mode" class="{{mode==='create'?'active':''}}">创建家庭</button><button data-mode="join" bindtap="mode" class="{{mode==='join'?'active':''}}">加入家庭</button></view><view class="panel"><block wx:if="{{mode==='create'}}"><view class="label">家庭名称</view><input value="{{name}}" data-field="name" bindinput="input" maxlength="30" disabled="{{busy}}"/></block><block wx:else><view class="label">家庭邀请码</view><input value="{{invite}}" data-field="invite" bindinput="input" placeholder="请家人分享有效邀请码" maxlength="40" disabled="{{busy}}"/></block><button bindtap="submit" disabled="{{busy || loading}}" loading="{{busy}}">{{mode==='create'?'创建家庭':'加入家庭'}}</button></view><button class="text-button" bindtap="profile">个人中心与提交恢复</button></view>